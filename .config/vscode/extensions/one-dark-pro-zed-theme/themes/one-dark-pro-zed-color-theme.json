  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7f838c" }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": { "foreground": "#c678dd" }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#abb2bf" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": { "foreground": "#61afef" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp constant.character.escape"],
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "scope": ["string.regexp", "string.other.link"],
      "settings": { "foreground": "#e15687" }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant",
        "entity.other.attribute-name",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#d19a66" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class",
        "variable.language"
      ],
      "settings": { "foreground": "#e5c07b" }
    },
    {
      "scope": ["entity.name.type.enum", "entity.name.type.enum-member", "variable.other.enummember"],
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "entity.name.tag",
        "support.class.component",
        "entity.name.function.constructor"
      ],
      "settings": { "foreground": "#e15687" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.object"],
      "settings": { "foreground": "#abb2bf" }
    },
    {
      "scope": ["markup.heading", "entity.name.section", "markup.heading punctuation.definition.heading"],
      "settings": { "foreground": "#d07277", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#c678dd", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#c678dd", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#61afef" }
    },
    {
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list punctuation.definition.list"],
      "settings": { "foreground": "#d07277" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#a5e075" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff616e" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#e5c07b" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c24038" }
    }
  ],
  "semanticTokenColors": {
    "comment": "#7f838c",
    "keyword": "#c678dd",
    "function": "#61afef",
    "method": "#61afef",
    "macro": "#61afef",
    "string": "#98c379",
    "number": "#d19a66",
    "type": "#e5c07b",
    "class": "#e5c07b",
    "interface": "#e5c07b",
    "struct": "#e5c07b",
    "typeParameter": "#e5c07b",
    "namespace": "#e5c07b",
    "enum": "#56b6c2",
    "enumMember": "#56b6c2",
    "variable": "#e15687",
    "parameter": "#e15687",
    "property": "#e15687",
    "variable.defaultLibrary": "#e5c07b",
    "variable.readonly": "#d19a66",
    "decorator": "#d19a66",
    "operator": "#abb2bf",
    "regexp": "#e15687"
  }
}
