  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6f7b68" }
    },
    {
      "name": "Keyword / Statement / Constant / Special",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "constant.other",
        "variable.language",
        "support.constant"
      ],
      "settings": { "foreground": "#cccccc" }
    },
    {
      "name": "Number / Boolean / Float",
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null"],
      "settings": { "foreground": "#6f7b68" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.separator.key-value"],
      "settings": { "foreground": "#DEBF7C" }
    },
    {
      "name": "String",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#A2A970" }
    },
    {
      "name": "Escape / Special char",
      "scope": ["constant.character.escape", "string.regexp", "constant.character"],
      "settings": { "foreground": "#C1C88D" }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": { "foreground": "#AA9AAC" }
    },
    {
      "name": "Type / Structure",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": { "foreground": "#E3D896" }
    },
    {
      "name": "Identifier",
      "scope": ["variable", "variable.parameter", "variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#8B9698" }
    },
    {
      "name": "PreProc",
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.control.import",
        "keyword.control.directive",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#8B9698" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#E3D896" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#AA9AAC" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#FEFEFE" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C34143" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#FFFEDB", "fontStyle": "bold" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#C1C88D" }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#A2A970" }
    },
    {
      "name": "Markup bold / italic",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#A2A970" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#C34143" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#DEBF7C" }
    }
  ],
  "semanticTokenColors": {
    "comment": "#6f7b68",
    "keyword": "#cccccc",
    "string": "#A2A970",
    "number": "#6f7b68",
    "regexp": "#C1C88D",
    "operator": "#DEBF7C",
    "function": "#AA9AAC",
    "method": "#AA9AAC",
    "macro": "#8B9698",
    "decorator": "#8B9698",
    "variable": "#8B9698",
    "parameter": "#8B9698",
    "property": "#8B9698",
    "enumMember": "#cccccc",
    "type": "#E3D896",
    "class": "#E3D896",
    "interface": "#E3D896",
    "struct": "#E3D896",
    "enum": "#E3D896",
    "typeParameter": "#E3D896",
    "namespace": "#E3D896"
  }
}
