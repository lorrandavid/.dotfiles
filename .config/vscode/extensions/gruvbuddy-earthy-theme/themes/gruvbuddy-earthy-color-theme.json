  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#857868",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d89058"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#d07068"
      }
    },
    {
      "scope": ["string", "string.quoted", "constant.character"],
      "settings": {
        "foreground": "#9aaa6e"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "string.interpolated punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#7aa3a0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d8b66a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ab8eab"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#7aa3a0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ab8eab",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameters variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#d2c1a0"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7e9fad"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#c9a45a"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#ab8eab",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#ab8eab"
      }
    },
    {
      "scope": ["entity.name.label"],
      "settings": {
        "foreground": "#c9a45a"
      }
    },
    {
      "scope": [
        "entity.name.decorator",
        "punctuation.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#d89058"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a89780"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#d89058",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#9aaa6e"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#7e9fad",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#d07068",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#e6d5b3",
    "variable.defaultLibrary": "#8a74a4",
    "parameter": "#d2c1a0",
    "property": "#7e9fad",
    "function": "#d8b66a",
    "method": "#d8b66a",
    "function.defaultLibrary": {
      "foreground": "#d8b66a",
      "bold": true
    },
    "method.defaultLibrary": {
      "foreground": "#d8b66a",
      "bold": true
    },
    "class": {
      "foreground": "#ab8eab",
      "italic": true
    },
    "interface": {
      "foreground": "#ab8eab",
      "italic": true
    },
    "type": {
      "foreground": "#ab8eab",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#ab8eab",
      "italic": true
    },
    "enum": "#ab8eab",
    "enumMember": "#d89058",
    "namespace": "#ab8eab",
    "decorator": "#d89058",
    "macro": "#d89058",
    "label": "#c9a45a",
    "string": "#9aaa6e",
    "number": "#d07068",
    "regexp": "#7aa3a0",
    "operator": "#7aa3a0"
  }
}
